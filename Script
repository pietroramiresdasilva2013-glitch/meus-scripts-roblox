-- Função para clicar APENAS no botão vermelho mais próximo do jogador
local function clicarBotaoProximo()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local myPos = character.HumanoidRootPart.Position
    
    local menorDistancia = 15 -- Só clica se o botão estiver perto de você (ex: na sua mesa)
    local alvoPrompt = nil
    local alvoClick = nil
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local pos = obj.Parent and obj.Parent:IsA("BasePart") and obj.Parent.Position
            if pos then
                local dist = (myPos - pos).Magnitude
                if dist < menorDistancia then
                    menorDistancia = dist
                    alvoPrompt = obj
                end
            end
        elseif obj:IsA("ClickDetector") then
            local pos = obj.Parent and obj.Parent:IsA("BasePart") and obj.Parent.Position
            if pos then
                local dist = (myPos - pos).Magnitude
                if dist < menorDistancia then
                    menorDistancia = dist
                    alvoClick = obj
                end
            end
        end
    end
    
    if alvoPrompt and fireproximityprompt then
        fireproximityprompt(alvoPrompt)
    elseif alvoClick and fireclickdetector then
        fireclickdetector(alvoClick)
    end
end

-- LOOP DE DETECÇÃO E PARADA EM TEMPO REAL
RunService.RenderStepped:Connect(function()
    if not autoActivated or jaApertou then return end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local myPos = character.HumanoidRootPart.Position

    local tempoAlvo = nil

    -- 1. TENTA ACHAR O ALVO DO MODO CADEIRA (Ex: "Pare em 8.00" perto do jogador)
    for _, gui in pairs(workspace:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("SurfaceGui") or gui:IsA("BillboardGui") then
            local txt = tostring(gui.Text or "")
            if string.find(txt, "Pare em") or string.find(txt, "pare em") then
                -- Extrai o número depois de 'Pare em'
                local num = string.match(txt, "%d+%.%d+") or string.match(txt, "%d+")
                if num then
                    -- Verifica se este aviso é da mesa onde o jogador está perto
                    local parentPart = gui:FindFirstAncestorWhichIsA("BasePart") or gui.Parent
                    if parentPart and parentPart:IsA("BasePart") then
                        if (myPos - parentPart.Position).Magnitude < 25 then
                            tempoAlvo = string.format("%.2f", tonumber(num))
                            break
                        end
                    else
                        tempoAlvo = string.format("%.2f", tonumber(num))
                    end
                end
            end
        end
    end

    -- 2. SE NÃO ACHOU "Pare em", TENTA O MODO PRÁTICA (Visor gigante no topo)
    if not tempoAlvo then
        for _, gui in pairs(workspace:GetDescendants()) do
            if gui:IsA("TextLabel") then
                local txt = tostring(gui.Text or "")
                if string.find(txt, "INTERROGER") or string.find(txt, "TEMPOMÊTRO") then
                    local num = string.match(txt, "%d+%.%d+")
                    if num then
                        tempoAlvo = num
                        break
                    end
                end
            end
        end
    end

    -- Exibe o alvo capturado no painel
    if tempoAlvo then
        statusAlvo.Text = "Alvo Atual: " .. tempoAlvo .. "s"
    else
        statusAlvo.Text = "Alvo: Procurando aviso..."
        return
    end

    -- 3. PROCURA O CRONÔMETRO CORRENTE NA MESA/TELA E CLICA QUANDO BATER O TEMPO ALVO
    for _, textObj in pairs(workspace:GetDescendants()) do
        if textObj:IsA("TextLabel") then
            local valorRelogio = tostring(textObj.Text)
            
            -- Se o cronômetro bateu exatamente com o Alvo (Ex: "08.00" ou "8.00")
            if valorRelogio == tempoAlvo or string.find(valorRelogio, tempoAlvo) then
                jaApertou = true
                clicarBotaoProximo()
                statusAcao.Text = "Status: PARADO EM " .. tempoAlvo .. "!"
                
                task.wait(2.5)
                jaApertou = false
                statusAcao.Text = "Status: Aguardando próxima rodada..."
                break
            end
        end
    end
end)
