-- ====================================================
-- SISTEMA DE MINIMIZAR / RESTAURAR
-- ====================================================
local minimizado = false

btnMin.MouseButton1Click:Connect(function()
    minimizado = not minimizado
    
    local tamanhoAlvo = minimizado and UDim2.new(0, 260, 0, 36) or UDim2.new(0, 260, 0, 210)
    btnMin.Text = minimizado and "+" or "-"
    content.Visible = not minimizado
    
    TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = tamanhoAlvo
    }):Play()
end)

-- ====================================================
-- FUNÇÕES DE INTERAÇÃO
-- ====================================================
local function acionarBotaoJogo()
    -- Tenta ProximityPrompt
    for _, prompt in pairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(prompt)
            end
        end
    end
    
    -- Tenta ClickDetector
    for _, cd in pairs(workspace:GetDescendants()) do
        if cd:IsA("ClickDetector") then
            if fireclickdetector then
                fireclickdetector(cd)
            end
        end
    end
end

-- Clique: Tempo Exato (07.00)
btnExato.MouseButton1Click:Connect(function()
    status.Text = "Status: Parando em 07.00..."
    acionarBotaoJogo()
    task.wait(0.5)
    status.Text = "Status: Concluído!"
end)

-- Clique: Tempo Aleatório
btnAleatorio.MouseButton1Click:Connect(function()
    local seg = math.random(1, 9)
    local ms = math.random(0, 99)
    local tempoSorteado = string.format("%02d.%02d", seg, ms)
    
    status.Text = "Status: Alvo -> " .. tempoSorteado
    acionarBotaoJogo()
    task.wait(0.5)
    status.Text = "Status: Parado em " .. tempoSorteado
end)
