local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 👑 SEU NOME DE USUÁRIO DO ROBLOX
local DONO_USERNAME = LocalPlayer.Name 

-- 📋 Sistema de Cargos
local RANKS = {
	DONO        = {Level = 5, TagText = "DONO MZ", TagColor = Color3.fromRGB(255, 0, 0)},
	SUPER_ADMIN = {Level = 4, TagText = "SUPER ADMIN", TagColor = Color3.fromRGB(255, 170, 0)},
	ADMIN       = {Level = 3, TagText = "ADMIN", TagColor = Color3.fromRGB(255, 215, 0)},
	MODERADOR   = {Level = 2, TagText = "MODERADOR", TagColor = Color3.fromRGB(0, 170, 255)},
	VIP         = {Level = 1, TagText = "VIP", TagColor = Color3.fromRGB(170, 0, 255)},
	MEMBRO      = {Level = 0, TagText = "", TagColor = Color3.fromRGB(255, 255, 255)}
}

local UserRanks = {}

-- 🎨 Função de Tag Acima da Cabeça (BillboardGui)
local function ApplyTag(player, character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	if head:FindFirstChild("AdminTag") then
		head.AdminTag:Destroy()
	end

	local rankData = UserRanks[player.UserId] or RANKS.MEMBRO
	if rankData.Level == 0 then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "AdminTag"
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = rankData.TagColor
	label.TextScaled = true
	label.Font = Enum.Font.SourceSansBold

	if rankData.Level == 5 then
		label.Text = "🔴 " .. rankData.TagText .. " 🔴\n[" .. player.DisplayName .. "]"
	else
		label.Text = "[" .. rankData.TagText .. "]\n" .. player.DisplayName
	end

	label.Parent = billboard
end

-- Configura cargos iniciais
for _, p in pairs(Players:GetPlayers()) do
	if p.Name == DONO_USERNAME then
		UserRanks[p.UserId] = RANKS.DONO
	else
		UserRanks[p.UserId] = RANKS.MEMBRO
	end
	if p.Character then ApplyTag(p, p.Character) end
	p.CharacterAdded:Connect(function(char) ApplyTag(p, char) end)
end

Players.PlayerAdded:Connect(function(p)
	UserRanks[p.UserId] = RANKS.MEMBRO
	p.CharacterAdded:Connect(function(char) ApplyTag(p, char) end)
end)

-- 📱 Interface Mobile (Delta GUI)
