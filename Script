-- Minimizar / Restaurar
MinBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		Content.Visible = false
		MainFrame.Size = MINI_SIZE
		MinBtn.Text = "+"
		Title.Size = UDim2.new(1, -70, 1, 0)
	else
		Content.Visible = true
		MainFrame.Size = NORMAL_SIZE
		MinBtn.Text = "—"
		Title.Size = UDim2.new(1, -70, 0, 35)
	end
end)

-- Salvar localização
SaveBtn.MouseButton1Click:Connect(function()
	if #savedLocations >= MAX_LOCATIONS then
		SaveBtn.Text = "❌ Máximo " .. MAX_LOCATIONS .. "!"
		task.wait(1.5)
		SaveBtn.Text = "💾 Salvar Localização"
		return
	end

	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		table.insert(savedLocations, {
			Position = hrp.Position,
			CFrame = hrp.CFrame
		})
		updateList()
		SaveBtn.Text = "✅ Salvo! (" .. #savedLocations .. "/" .. MAX_LOCATIONS .. ")"
		task.wait(1)
		SaveBtn.Text = "💾 Salvar Localização"
	end
end)

