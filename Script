-- ==================== FUNÇÕES ====================
local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function refreshList()
    for _, c in ipairs(ListFrame:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for i, data in ipairs(savedLocations) do
        local item = Instance.new("Frame")
        item.Size = UDim2.new(1, -4, 0, 28)
        item.BackgroundColor3 = (selectedIndex == i) and Color3.fromRGB(35, 90, 55) or Color3.fromRGB(38, 38, 50)
        item.BorderSizePixel = 0
        item.LayoutOrder = i
        item.Parent = ListFrame
        Instance.new("UICorner", item).CornerRadius = UDim.new(0, 6)

        local selectBtn = Instance.new("TextButton")
        selectBtn.Size = UDim2.new(1, -34, 1, 0)
        selectBtn.BackgroundTransparency = 1
        selectBtn.Text = (selectedIndex == i and "🟢 " or "⚪ ") .. data.name
        selectBtn.TextColor3 = (selectedIndex == i) and Color3.fromRGB(160, 255, 180) or Color3.fromRGB(210, 210, 225)
        selectBtn.Font = Enum.Font.Gotham
        selectBtn.TextSize = 12
        selectBtn.TextXAlignment = Enum.TextXAlignment.Left
        selectBtn.Parent = item
        local pad = Instance.new("UIPadding", selectBtn)
        pad.PaddingLeft = UDim.new(0, 8)

        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 26, 0, 22)
        delBtn.Position = UDim2.new(1, -30, 0.5, -11)
        delBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        delBtn.Text = "X"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Font = Enum.Font.GothamBold
        delBtn.TextSize = 11
        delBtn.Parent = item
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 5)

        selectBtn.MouseButton1Click:Connect(function()
            selectedIndex = i
            refreshList()
            Status.Text = "Selecionado: " .. data.name
            Status.TextColor3 = Color3.fromRGB(120, 220, 150)
        end)

        delBtn.MouseButton1Click:Connect(function()
            table.remove(savedLocations, i)
            if selectedIndex == i then
                selectedIndex = nil
                Status.Text = "Nenhuma localização selecionada"
                Status.TextColor3 = Color3.fromRGB(140, 140, 160)
            elseif selectedIndex and selectedIndex > i then
                selectedIndex = selectedIndex - 1
            end
            refreshList()
        end)
    end
end

local function refreshConfigList()
    for _, c in ipairs(ConfigList:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for i, cfg in ipairs(configs) do
        local item = Instance.new("Frame")
        item.Size = UDim2.new(1, -4, 0, 30)
        item.BackgroundColor3 = (selectedConfig == i) and Color3.fromRGB(40, 80, 120) or Color3.fromRGB(40, 40, 55)
        item.BorderSizePixel = 0
        item.LayoutOrder = i
        item.Parent = ConfigList
        Instance.new("UICorner", item).CornerRadius = UDim.new(0, 6)

        local selectBtn = Instance.new("TextButton")
        selectBtn.Size = UDim2.new(1, -34, 1, 0)
        selectBtn.BackgroundTransparency = 1
        selectBtn.Text = (selectedConfig == i and "🟢 " or "⚪ ") .. cfg.name
        selectBtn.TextColor3 = Color3.fromRGB(220, 220, 240)
        selectBtn.Font = Enum.Font.Gotham
        selectBtn.TextSize = 12
        selectBtn.TextXAlignment = Enum.TextXAlignment.Left
        selectBtn.Parent = item
        local pad = Instance.new("UIPadding", selectBtn)
        pad.PaddingLeft = UDim.new(0, 8)

        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 26, 0, 22)
        delBtn.Position = UDim2.new(1, -30, 0.5, -11)
        delBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        delBtn.Text = "X"
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Font = Enum.Font.GothamBold
        delBtn.TextSize = 11
        delBtn.Parent = item
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 5)

        selectBtn.MouseButton1Click:Connect(function()
            selectedConfig = i
            refreshConfigList()
            ConfigStatus.Text = "Selecionado: " .. cfg.name
            ConfigStatus.TextColor3 = Color3.fromRGB(120, 200, 255)
        end)

        delBtn.MouseButton1Click:Connect(function()
            table.remove(configs, i)
            if selectedConfig == i then
                selectedConfig = nil
                ConfigStatus.Text = "Nenhuma config selecionada"
                ConfigStatus.TextColor3 = Color3.fromRGB(150, 150, 170)
            elseif selectedConfig and selectedConfig > i then
                selectedConfig = selectedConfig - 1
            end
            refreshConfigList()
        end)
    end
end

-- Arrastar
local dragging, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Minimizar
MinimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    Content.Visible = not minimized
    Main.Size = minimized and UDim2.new(0, 240, 0, 34) or UDim2.new(0, 240, 0, 455)
    MinimizeBtn.Text = minimized and "+" or "–"
end)

-- Salvar Local
SaveBtn.MouseButton1Click:Connect(function()
    if #savedLocations >= maxSlots then
        Status.Text = "Máximo de locais!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    local hrp = getHRP()
    if not hrp then return end
    local num = #savedLocations + 1
    table.insert(savedLocations, {name = "Local " .. num, cframe = hrp.CFrame})
    selectedIndex = num
    refreshList()
    Status.Text = "Salvo: Local " .. num
    Status.TextColor3 = Color3.fromRGB(120, 220, 150)
end)

-- TP
TPBtn.MouseButton1Click:Connect(function()
    if not selectedIndex or not savedLocations[selectedIndex] then
        Status.Text = "Selecione um local!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = savedLocations[selectedIndex].cframe
        Status.Text = "Teleportado!"
        Status.TextColor3 = Color3.fromRGB(100, 180, 255)
    end
end)

