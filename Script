-- Carrega a Biblioteca do Painel (Orion Library)
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

-- Cria a Janela Principal com o Título Colorido em HTML/RichText
local Window = OrionLib:MakeWindow({
    Name = "<font color='#FF0055'>M</font><font color='#FF7700'>Z</font> <font color='#00FFDD'>H</font><font color='#0088FF'>U</font><font color='#AA00FF'>B</font>", 
    HidePremium = false, 
    SaveConfig = false, 
    ConfigFolder = "MZHubConfig"
})

-- Aba do ESP
local TabESP = Window:MakeTab({
    Name = "ESP / Visuals",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- Variáveis de Controle
local ESP_Enabled = false
local ESP_Boxes = {}
local ESP_Names = {}

-- Função para Criar e Atualizar os ESPs
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

local function createESP(player)
    if player == LocalPlayer then return end

    -- Criar Highlight (Box Colorido em volta do personagem)
    local highlight = Instance.new("Highlight")
    highlight.Name = "MZ_ESP_" .. player.Name
    highlight.FillColor = Color3.fromRGB(255, 0, 100)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Enabled = ESP_Enabled

    -- Criar Nome Flutuante (BillboardGui)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MZ_Name_" .. player.Name
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Enabled = ESP_Enabled

    local label = Instance.new("TextLabel")
    label.Parent = billboard
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = player.DisplayName .. " (@" .. player.Name .. ")"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextSize = 14
    label.Font = Enum.Font.SourceSansBold

    -- Aplicar quando o personagem carregar
    local function applyToCharacter(char)
        if char then
            highlight.Parent = char
            
            local head = char:WaitForChild("Head", 5)
            if head then
                billboard.Adornee = head
                billboard.Parent = head
            end
        end
    end

    if player.Character then applyToCharacter(player.Character) end
    player.CharacterAdded:Connect(applyToCharacter)

    ESP_Boxes[player] = highlight
    ESP_Names[player] = billboard
end

-- Monitorar Entrada de Novos Jogadores
for _, player in pairs(Players:GetPlayers()) do
    createESP(player)
end
Players.PlayerAdded:Connect(createESP)

-- Alternar o ESP ON/OFF
TabESP:AddToggle({
    Name = "Ativar ESP (Boxes & Nomes)",
    Default = false,
    Callback = function(Value)
        ESP_Enabled = Value
        for player, highlight in pairs(ESP_Boxes) do
            if highlight then highlight.Enabled = Value end
        end
        for player, billboard in pairs(ESP_Names) do
            if billboard then billboard.Enabled = Value end
        end
    end    
})

-- Inicializa o Painel
OrionLib:Init()
