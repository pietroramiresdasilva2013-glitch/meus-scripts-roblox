-- Configurações
local TEMPO_ALVO = "07.00" -- Coloque aqui o tempo exato que precisa acertar

-- Função para encontrar o display/botão (Adapte os nomes se necessário)
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Procura na UI do jogador ou no Workspace pelo cronômetro
print("Script ativado! Aguardando o tempo: " .. TEMPO_ALVO)

task.spawn(function()
    while task.wait() do
        -- Exemplo pegando via SurfaceGui/TextLabel do jogo
        for _, gui in pairs(game:GetDescendants()) do
            if gui:IsA("TextLabel") or gui:IsA("SurfaceGui") then
                -- Verifica se o texto atual é igual ao tempo configurado
                if string.find(tostring(gui.Text), TEMPO_ALVO) then
                    -- Simula o clique ou interação com a ProximityPrompt/Botão
                    print("Tempo atingido! Apertando botão...")
                    
                    -- Se o jogo usa ProximityPrompt:
                    for _, prompt in pairs(workspace:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            fireproximityprompt(prompt)
                        end
                    end
                    
                    -- Se o jogo usa toque direto (ClickDetector):
                    for _, cd in pairs(workspace:GetDescendants()) do
                        if cd:IsA("ClickDetector") then
                            fireclickdetector(cd)
                        end
                    end
                    
                    break
                end
            end
        end
    end
end)
