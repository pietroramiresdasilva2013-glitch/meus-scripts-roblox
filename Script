local function AddToggle(name, default, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 34)
    f.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
    f.Parent = Content
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

