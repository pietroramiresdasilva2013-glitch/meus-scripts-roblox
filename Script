-- Garante compatibilidade e limpa instâncias antigas se re-executado
if getgenv().MZ_ESP_Loaded then 
    getgenv().MZ_ESP_Loaded:Disconnect()
end

-- Carrega a Orion Library
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

-- Título Colorido MZ HUB
local Window = OrionLib:MakeWindow({
    Name = "<font color='#FF0055'>M</font><font color='#FF7700'>Z</font> <font color='#00FFDD'>H</font><font color='#0088FF'>U</font><font color='#AA00FF'>B</font>", 
    HidePremium = false, 
    SaveConfig = false, 
    ConfigFolder = "MZHubMobile"
})

local TabESP = Window:MakeTab({
    Name = "ESP Universal",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- Configurações Globais
getgenv().ESP_Enabled = false
getgenv().ESP_TeamCheck = false

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Pasta no Gui do Jogador para evitar lags de renderização
local CoreGui = game:GetService("CoreGui")
local ScreenGui = CoreGui:FindFirstChild("MZ_ESP_Container")

if ScreenGui then ScreenGui:Destroy() end
ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MZ_ESP_Container"
ScreenGui.Parent = CoreGui

-- Criador de ESP individual
local ESP_Objects = {}

local function removeESP(player)
    if ESP_Objects[player] then
        if ESP_Objects[player].Box then ESP_Objects[player].Box:Destroy() end
        if ESP_Objects[player].Name then ESP_Objects[player].Name:Destroy() end
        ESP_Objects[player] = nil
    end
end

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                -- Checagem de vida e visibilidade
                if humanoid.Health > 0 then
                    local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if onScreen and getgenv().ESP_Enabled then
                        -- Criar objetos se não existirem
                        if not ESP_Objects[player] then
                            local box = Instance.new("Frame")
                            box.BackgroundTransparency = 1
                            box.BorderSizePixel = 2
                            box.BorderColor3 = Color3.fromRGB(255, 0, 85)
                            box.Parent = ScreenGui

                            local name = Instance.new("TextLabel")
                            name.BackgroundTransparency = 1
                            name.TextColor3 = Color3.fromRGB(255, 255, 255)
                            name.TextStrokeTransparency = 0
                            name.TextSize = 13
                            name.Font = Enum.Font.SourceSansBold
                            name.Parent = ScreenGui

                            ESP_Objects[player] = {Box = box, Name = name}
                        end

                        -- Cálculo de tamanho adaptativo da Box universal
                        local headPos = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height / 1.5

                        -- Atualiza Box
                        local box = ESP_Objects[player].Box
                        box.Size = UDim2.new(0, width, 0, height)
                        box.Position = UDim2.new(0, hrpPos.X - (width / 2), 0, hrpPos.Y - (height / 2))
                        box.Visible = true

                        -- Atualiza Nome e Distância
                        local name = ESP_Objects[player].Name
                        local distance = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                        name.Text = player.DisplayName .. " [" .. distance .. "m]"
                        name.Position = UDim2.new(0, hrpPos.X - 100, 0, hrpPos.Y - (height / 2) - 18)
                        name.Size = UDim2.new(0, 200, 0, 15)
                        name.Visible = true
                    else
                        if ESP_Objects[player] then
                            ESP_Objects[player].Box.Visible = false
                            ESP_Objects[player].Name.Visible = false
                        end
                    end
                else
                    removeESP(player)
                end
            else
                removeESP(player)
            end
        end
    end
end

-- Limpa ESP de quem sair do jogo
Players.PlayerRemoving:Connect(removeESP)

-- Loop principal otimizado para Mobile
getgenv().MZ_ESP_Loaded = game:GetService("RunService").RenderStepped:Connect(function()
    if getgenv().ESP_Enabled then
        updateESP()
    else
        for _, obj in pairs(ESP_Objects) do
            if obj.Box then obj.Box.Visible = false end
            if obj.Name then obj.Name.Visible = false end
        end
    end
end)

-- Botão de Toggle no Menu
TabESP:AddToggle({
    Name = "Ativar ESP (Universal)",
    Default = false,
    Callback = function(Value)
        getgenv().ESP_Enabled = Value
    end    
})

OrionLib:Init()
