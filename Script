-- Auto Farm
AutoFarmBtn.MouseButton1Click:Connect(function()
	if not selectedLocation then
		AutoFarmBtn.Text = "⚠️ Selecione um local!"
		task.wait(1.5)
		AutoFarmBtn.Text = "⚡ Auto Farm: OFF"
		return
	end
	if not baseCFrame then
		AutoFarmBtn.Text = "⚠️ Salve a Base primeiro!"
		task.wait(1.5)
		AutoFarmBtn.Text = "⚡ Auto Farm: OFF"
		return
	end

	autoFarm = not autoFarm
	if autoFarm then
		AutoFarmBtn.Text = "⚡ Auto Farm: ON"
		AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
		autoPegar = true
		AutoPegarBtn.Text = "🖐 Auto Pegar: ON"
		AutoPegarBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
	else
		AutoFarmBtn.Text = "⚡ Auto Farm: OFF"
		AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
		autoPegar = false
		AutoPegarBtn.Text = "🖐 Auto Pegar: OFF"
		AutoPegarBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	end
end)

