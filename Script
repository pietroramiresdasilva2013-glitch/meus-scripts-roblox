    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        holding = false
    end
end)

RunService.RenderStepped:Connect(function()
    if S.Aimbot and holding then
        local t = GetClosest()
        if t then
            local goal = CFrame.new(Camera.CFrame.Position, t.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goal, S.Smooth)
        end
    end
end)

-- ====================== ESP (Drawing) ======================
local drawings = {}

local function ClearDrawings()
    for _, d in pairs(drawings) do
        if d.Remove then d:Remove() elseif d.Destroy then d:Destroy() end
    end
    table.clear(drawings)
end

local function GetColor()
    if S.Rainbow then
        return Color3.fromHSV((tick() * 0.4) % 1, 0.9, 1)
    end
    return S.Color
end

RunService.RenderStepped:Connect(function()
    ClearDrawings()
    if not S.ESP then return end

    local color = GetColor()

    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then continue end
        if S.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end

        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > S.Distance then continue end

        local head = char:FindFirstChild("Head")
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then continue end

        -- Tracer
        if S.Tracer then
            local line = Drawing.new("Line")
            line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            line.To = Vector2.new(pos.X, pos.Y)
            line.Color = color
            line.Thickness = 1
            line.Transparency = 0.7
            table.insert(drawings, line)
        end

        -- Box
        if S.Box and head then
            local headPos = Camera:WorldToViewportPoint(head.Position)
            local size = math.clamp(2000 / dist, 8, 40)
            local box = Drawing.new("Square")
            box.Size = Vector2.new(size, size * 1.6)
            box.Position = Vector2.new(pos.X - size/2, headPos.Y - 5)
            box.Color = color
            box.Thickness = 1
            box.Filled = false
            table.insert(drawings, box)
        end

        -- Health
        if S.Health then
            local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bar = Drawing.new("Line")
            local h = math.clamp(2000 / dist, 12, 50)
            bar.From = Vector2.new(pos.X - 20, pos.Y + h/2)
            bar.To = Vector2.new(pos.X - 20, pos.Y + h/2 - h * hp)
            bar.Color = Color3.fromRGB(255 * (1-hp), 255 * hp, 40)
            bar.Thickness = 2
            table.insert(drawings, bar)
        end

        -- Skeleton simples (R6/R15)
        if S.Skeleton then
            local function drawLine(p1, p2)
                if not p1 or not p2 then return end
                local a, ona = Camera:WorldToViewportPoint(p1.Position)
                local b, onb = Camera:WorldToViewportPoint(p2.Position)
                if ona and onb then
                    local l = Drawing.new("Line")
                    l.From = Vector2.new(a.X, a.Y)
                    l.To = Vector2.new(b.X, b.Y)
                    l.Color = color
                    l.Thickness = 1.2
                    table.insert(drawings, l)
                end
            end

            local h = char:FindFirstChild("Head")
            local t = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            local lt = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
            local rt = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
            local ll = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg")
            local rl = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")

            if h and t then drawLine(h, t) end
            if t and lt then drawLine(t, lt) end
            if t and rt then drawLine(t, rt) end
            if t and ll then drawLine(t, ll) end
            if t and rl then drawLine(t, rl) end
        end
    end
end)

