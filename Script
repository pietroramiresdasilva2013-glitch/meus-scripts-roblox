-- Loop Auto Farm (Mobile)
task.spawn(function()
    while true do
        if autoFarm and selectedIndex and savedLocations[selectedIndex] then
            local hrp = getHRP()
            if hrp then
                hrp.CFrame = savedLocations[selectedIndex].cframe
                task.wait(7)
                if savedLocations[1] then
                    hrp.CFrame = savedLocations[1].cframe
                    task.wait(2.5)
                end
            end
        end
        task.wait(0.4)
    end
end)

