-- 1. Sistema de Minimizar / Restaurar com Animação (Tween)
local minimizado = false
local tamanhoOriginal = UDim2.new(0, 300, 0, 220)
local tamanhoMinimizado = UDim2.new(0, 300, 0, 35)

btnMinimizar.MouseButton1Click:Connect(function()
    minimizado = not minimizado
    
    local tamanhoAlvo = minimizado and tamanhoMinimizado or tamanhoOriginal
    local textoBotao = minimizado and "+" or "-"
    
    btnMinimizar.Text = textoBotao
    
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(mainFrame, tweenInfo, {Size = tamanhoAlvo})
    tween:Play()
end)

-- 2. Função de Ação: Executar Parada
local function dispararParada(tempoAlvo)
    statusLabel.Text = "Procurando tempo: " .. tempoAlvo
    
    -- Exemplo de acionamento de ProximityPrompt ou Interação
    local acionado = false
    for _, prompt in pairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            fireproximityprompt(prompt)
            acionado = true
        end
    end
    
    if acionado then
        statusLabel.Text = "Parado em: " .. tempoAlvo
    else
        statusLabel.Text = "Nenhum botão encontrado perto!"
    end
end

-- 3. Clique no Botão: Tempo Exato
btnExato.MouseButton1Click:Connect(function()
    local tempoDefinido = "07.00"
    dispararParada(tempoDefinido)
end)

-- 4. Clique no Botão: Tempo Aleatório
btnAleatorio.MouseButton1Click:Connect(function()
    -- Gera um tempo aleatório entre 01.00 e 10.00 segundos
    local segundos = math.random(1, 10)
    local milissegundos = math.random(0, 99)
    local tempoAleatorio = string.format("%02d.%02d", segundos, milissegundos)
    
    dispararParada(tempoAleatorio)
end)
