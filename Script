-- ====================================================
-- LÓGICA DE CAPTURA AUTOMÁTICA DE ALVO ALEATÓRIO
-- ====================================================
local autoActivated = false
local alvoAtual = nil
local jaApertou = false

-- Minimizar Painel
local minimizado = false
btnMin.MouseButton1Click:Connect(function()
    minimizado = not minimizado
    btnMin.Text = minimizado and "+" or "-"
    content.Visible = not minimizado
    
    TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Size = minimizado and UDim2.new(0, 250, 0, 36) or UDim2.new(0, 250, 0, 160)
    }):Play()
end)

-- Ligar / Desligar Botão
btnToggle.MouseButton1Click:Connect(function()
    autoActivated = not autoActivated
    jaApertou = false
    
    if autoActivated then
        btnToggle.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        btnToggle.Text = "Auto Clicker: LIGADO ⚡"
        statusAcao.Text = "Status: Procurando alvo..."
    else
        btnToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        btnToggle.Text = "Auto Clicker: DESLIGADO"
        statusAcao.Text = "Status: Parado"
    end
end)

-- Função para clicar no botão do jogo
local function dispararClique()
    for _, prompt in pairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and fireproximityprompt then
            fireproximityprompt(prompt)
        end
    end
    for _, cd in pairs(workspace:GetDescendants()) do
        if cd:IsA("ClickDetector") and fireclickdetector then
            fireclickdetector(cd)
        end
    end
end

-- Monitor em Tempo Real
RunService.RenderStepped:Connect(function()
    if not autoActivated then return end

    -- 1. Varre o jogo procurando o texto que indica o objetivo aleatório da rodada (Ex: "03.25")
    for _, gui in pairs(workspace:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("SurfaceGui") then
            local texto = tostring(gui.Text)
            
            -- Procura por formato de tempo (número.número ex: 04.50, 10.12) perto de avisos
            local acheiTempo = string.match(texto, "%d%d%.%d%d")
            
            if acheiTempo then
                local textoLower = string.lower(texto)
                -- Verifica se é o texto do comando da rodada
                if string.find(textoLower, "tempômetro") or string.find(textoLower, "tempo") or string.find(textoLower, "interroger") or string.find(textoLower, "alvo") then
                    if alvoAtual ~= acheiTempo then
                        alvoAtual = acheiTempo
                        statusAlvo.Text = "Alvo da Rodada: " .. alvoAtual .. "s"
                        jaApertoures = false -- Reseta para o novo alvo
                        jaApertou = false
                    end
                end
            end
        end
    end

    -- 2. Se já descobriu o alvo da rodada, fica checando o visor principal para bater o tempo exato
    if alvoAtual and not jaApertou then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") then
                -- Compara o texto do visor do cronômetro rodando com o alvo aleatório capturado
                if obj.Text == alvoAtual or string.find(obj.Text, alvoAtual) then
                    jaApertou = true
                    dispararClique()
                    statusAcao.Text = "Status: PAROU EM " .. alvoAtual .. "!"
                    
                    -- Aguarda a rodada reiniciar e limpa o alvo antigo para pegar o próximo aleatório
                    task.wait(3)
                    alvoAtual = nil
                    statusAlvo.Text = "Alvo da Rodada: Sorteando nova..."
                    statusAcao.Text = "Status: Aguardando..."
                    jaApertou = false
                    break
                end
            end
        end
    end
end)
