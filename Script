-- Funções de criação de UI
local function CreateToggle(name, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = Content
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -55, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.Font = Enum.Font.Gotham
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(230,230,240)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(0, 42, 0, 22)
    status.Position = UDim2.new(1, -50, 0.5, -11)
    status.BackgroundColor3 = default and Color3.fromRGB(40,170,70) or Color3.fromRGB(55,55,65)
    status.Text = default and "ON" or "OFF"
    status.Font = Enum.Font.GothamBold
    status.TextSize = 12
    status.TextColor3 = Color3.new(1,1,1)
    status.Parent = btn
    Instance.new("UICorner", status).CornerRadius = UDim.new(0, 6)

    local on = default
    btn.MouseButton1Click:Connect(function()
        on = not on
        status.Text = on and "ON" or "OFF"
        status.BackgroundColor3 = on and Color3.fromRGB(40,170,70) or Color3.fromRGB(55,55,65)
        if callback then callback(on) end
    end)
end

