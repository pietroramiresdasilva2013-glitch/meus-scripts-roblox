-- Salvar Configuração
SaveConfigBtn.MouseButton1Click:Connect(function()
	if #savedLocations == 0 and not baseCFrame then
		SaveConfigBtn.Text = "⚠️ Nada pra salvar!"
		task.wait(1.5)
		SaveConfigBtn.Text = "💾 Salvar Configuração"
		return
	end

	local locsCopy = {}
	for _, loc in ipairs(savedLocations) do
		table.insert(locsCopy, {
			Position = loc.Position,
			CFrame = loc.CFrame
		})
	end

	table.insert(savedConfigs, {
		locations = locsCopy,
		base = baseCFrame
	})

	updateConfigList()
	SaveConfigBtn.Text = "✅ Configuração Salva!"
	task.wait(1.2)
	SaveConfigBtn.Text = "💾 Salvar Configuração"
end)

-- Executar Configuração
ExecConfigBtn.MouseButton1Click:Connect(function()
	if not selectedConfig then
		ExecConfigBtn.Text = "⚠️ Selecione uma config!"
		task.wait(1.5)
		ExecConfigBtn.Text = "▶️ Executar Configuração"
		return
	end

	savedLocations = {}
	for _, loc in ipairs(selectedConfig.locations) do
		table.insert(savedLocations, {
			Position = loc.Position,
			CFrame = loc.CFrame
		})
	end
	baseCFrame = selectedConfig.base

	selectedLocation = nil
	selectedButton = nil
	updateList()

	ExecConfigBtn.Text = "✅ Configuração Carregada!"
	task.wait(1.2)
	ExecConfigBtn.Text = "▶️ Executar Configuração"
	ConfigOverlay.Visible = false
end)

-- Loop Auto Pegar
task.spawn(function()
	while true do
		if autoPegar then
			for _, prompt in pairs(workspace:GetDescendants()) do
				if prompt:IsA("ProximityPrompt") and prompt.Enabled then
					pcall(function()
						fireproximityprompt(prompt)
					end)
				end
			end
		end
		task.wait(0.12)
	end
end)

-- Loop Auto Farm
task.spawn(function()
	while true do
		if autoFarm and selectedLocation and baseCFrame then
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.CFrame = selectedLocation.CFrame
				task.wait(0.4)
				autoPegar = true
				task.wait(FARM_TIME)
				hrp.CFrame = baseCFrame
				task.wait(1.5)
			end
		else
			task.wait(0.5)
		end
	end
end)

