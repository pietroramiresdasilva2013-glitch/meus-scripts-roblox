local isPlayerListOpen = false
AddButton("▼ Selecionar Jogador (Lista do Servidor)", Color3.fromRGB(0, 170, 255), function()
	isPlayerListOpen = not isPlayerListOpen
	if isPlayerListOpen then
		TweenService:Create(PlayerListFrame, TweenInfo.new(0.3), {Size = UDim2.new(0.95, 0, 0, 120)}):Play()
		-- Atualiza a lista de jogadores
		for _, child in pairs(PlayerListFrame:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		
		for _, p in pairs(Players:GetPlayers()) do
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(0.95, 0, 0, 28)
			pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			pBtn.Text = p.Name .. " (" .. (UserRanks[p.UserId] and UserRanks[p.UserId].TagText or "MEMBRO") .. ")"
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			pBtn.Font = Enum.Font.Gotham
			pBtn.TextSize = 11
			pBtn.Parent = PlayerListFrame
			
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 4)
			c.Parent = pBtn
			
			pBtn.MouseButton1Click:Connect(function()
				selectedTarget = p
				SelectedLabel.Text = "Alvo: " .. p.Name
			end)
		end
	else
		TweenService:Create(PlayerListFrame, TweenInfo.new(0.3), {Size = UDim2.new(0.95, 0, 0, 0)}):Play()
	end
end)

