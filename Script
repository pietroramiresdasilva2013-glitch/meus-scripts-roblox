-- Confirmar Venda
ConfirmSellBtn.MouseButton1Click:Connect(function()
    if not selectedSellType then return end

    -- Tenta vender usando ProximityPrompt
    pcall(function()
        for _, prompt in pairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                local text = (prompt.ActionText or ""):lower()
                local obj = (prompt.ObjectText or ""):lower()
                if text:find("vender") or obj:find("vender") or text:find("sell") then
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                end
            end
        end
    end)

    Status.Text = "Vendendo (" .. selectedSellType .. ")..."
    Status.TextColor3 = Color3.fromRGB(100, 220, 150)

    ConfirmSellBtn.Text = "✅  Vendido!"
    task.delay(1.2, function()
        if ConfirmSellBtn then
            ConfirmSellBtn.Text = "💰  VENDER AGORA"
        end
    end)
end)

-- Loop Auto Pegar
task.spawn(function()
    while true do
        if autoPegar then
            pcall(function()
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        if fireproximityprompt then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end)
        end
        task.wait(0.15)
    end
end)

