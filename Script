-- 👑 DIGITE O SEU NICKNAME EXATO DO ROBLOX AQUI DENTRO DAS ASPAS
local MEU_NICK = "SEU_NICK_AQUI"

-- 📋 Tabela de Cargos e Hierarquia de Permissões
local RANKS = {
	DONO        = {Level = 5, TagText = "DONO MZ", TagColor = Color3.fromRGB(255, 45, 85)},
	SUPER_ADMIN = {Level = 4, TagText = "SUPER ADMIN", TagColor = Color3.fromRGB(255, 149, 0)},
	ADMIN       = {Level = 3, TagText = "ADMIN", TagColor = Color3.fromRGB(255, 204, 0)},
	MODERADOR   = {Level = 2, TagText = "MODERADOR", TagColor = Color3.fromRGB(52, 199, 89)},
	VIP         = {Level = 1, TagText = "VIP", TagColor = Color3.fromRGB(175, 82, 222)},
	MEMBRO      = {Level = 0, TagText = "", TagColor = Color3.fromRGB(255, 255, 255)}
}

local UserRanks = {}
local SelectedTarget = nil

-- Função de Tags acima da cabeça
local function ApplyTag(player, character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	if head:FindFirstChild("AdminTag") then
		head.AdminTag:Destroy()
	end

	local rankData = UserRanks[player.UserId] or RANKS.MEMBRO
	if rankData.Level == 0 then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "AdminTag"
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 2.8, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = rankData.TagColor
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold

	if rankData.Level == 5 then
		label.Text = "👑 " .. rankData.TagText .. " 👑\n[" .. player.DisplayName .. "]"
	else
		label.Text = "[" .. rankData.TagText .. "]\n" .. player.DisplayName
	end

	label.Parent = billboard
end

-- Determina o nível inicial (Garante que só VOCÊ seja Dono)
for _, p in pairs(Players:GetPlayers()) do
	if p.Name == MEU_NICK then
		UserRanks[p.UserId] = RANKS.DONO
	else
		UserRanks[p.UserId] = RANKS.MEMBRO
	end
	if p.Character then ApplyTag(p, p.Character) end
	p.CharacterAdded:Connect(function(char) ApplyTag(p, char) end)
end

Players.PlayerAdded:Connect(function(p)
	if p.Name == MEU_NICK then
		UserRanks[p.UserId] = RANKS.DONO
	else
		UserRanks[p.UserId] = RANKS.MEMBRO
	end
	p.CharacterAdded:Connect(function(char) ApplyTag(p, char) end)
end)

---------------------------------------------------------
-- 🕹️ SISTEMA DE COMANDOS EXECUÇÃO
---------------------------------------------------------

local function ExecuteCommand(cmdString, sender)
	local myRank = UserRanks[sender.UserId] or RANKS.MEMBRO
	local cleanCmd = string.gsub(cmdString, "^[;:!]", "") -- Remove ; : ! do início
	local args = string.split(cleanCmd, " ")
	local command = string.lower(args[1] or "")
	local targetName = args[2]

	local function GetTarget()
		if targetName then
			for _, p in pairs(Players:GetPlayers()) do
				if string.lower(p.Name):sub(1, #targetName) == string.lower(targetName) then
					return p
				end
			end
		end
		return SelectedTarget
	end

	local targetPlayer = GetTarget()

	---------------------------------------------------------
	-- 👑 COMANDOS DE SUPER ADMIN E DONO (Nível 4+)
	---------------------------------------------------------
	if myRank.Level >= 4 then
		if command == "kill" and targetPlayer and targetPlayer.Character then
			local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.Health = 0 end
		
		elseif (command == "ice" or command == "freeze") and targetPlayer and targetPlayer.Character then
			for _, part in pairs(targetPlayer.Character:GetChildren()) do
				if part:IsA("BasePart") then part.Anchored = true end
			end

		elseif (command == "unice" or command == "unfreeze") and targetPlayer and targetPlayer.Character then
			for _, part in pairs(targetPlayer.Character:GetChildren()) do
				if part:IsA("BasePart") then part.Anchored = false end
			end

		elseif command == "jail" and targetPlayer and targetPlayer.Character then
			local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local cage = Instance.new("Model", workspace)
				cage.Name = "JailCage_" .. targetPlayer.Name
				local pos = root.Position

				local function MakeWall(cframe, size)
					local p = Instance.new("Part", cage)
					p.Size = size
					p.CFrame = cframe
					p.Anchored = true
					p.Material = Enum.Material.Metal
					p.BrickColor = BrickColor.new("Really black")
					p.Transparency = 0.3
				end

				MakeWall(CFrame.new(pos + Vector3.new(0, -3.5, 0)), Vector3.new(6, 1, 6)) -- Chão
				MakeWall(CFrame.new(pos + Vector3.new(0, 3.5, 0)), Vector3.new(6, 1, 6))  -- Teto
				MakeWall(CFrame.new(pos + Vector3.new(3, 0, 0)), Vector3.new(1, 6, 6))   -- Lado 1
				MakeWall(CFrame.new(pos + Vector3.new(-3, 0, 0)), Vector3.new(1, 6, 6))  -- Lado 2
				MakeWall(CFrame.new(pos + Vector3.new(0, 0, 3)), Vector3.new(6, 6, 1))   -- Lado 3
				MakeWall(CFrame.new(pos + Vector3.new(0, 0, -3)), Vector3.new(6, 6, 1))  -- Lado 4
			end

		elseif command == "unjail" and targetPlayer then
			local cage = workspace:FindFirstChild("JailCage_" .. targetPlayer.Name)
			if cage then cage:Destroy() end
		end
	end

	---------------------------------------------------------
	-- 🛡️ COMANDOS DE ADMIN (Nível 3+)
	---------------------------------------------------------
	if myRank.Level >= 3 then
		if command == "kick" and targetPlayer then
			targetPlayer:Kick("Você foi expulso pelo Admin.")
		end
	end

	---------------------------------------------------------
	-- 🚀 COMANDOS DE VIP (Nível 1+)
	---------------------------------------------------------
	if myRank.Level >= 1 then
		if command == "speed" then
			local val = tonumber(args[2]) or 50
			if sender.Character and sender.Character:FindFirstChildOfClass("Humanoid") then
				sender.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = val
			end
		end
	end
end

-- Detectar comandos digitados no Chat por qualquer um
for _, p in pairs(Players:GetPlayers()) do
	p.Chatted:Connect(function(msg)
		ExecuteCommand(msg, p)
	end)
end
Players.PlayerAdded:Connect(function(p)
	p.Chatted:Connect(function(msg)
		ExecuteCommand(msg, p)
	end)
end)

